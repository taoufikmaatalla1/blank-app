# Copy to your hosting provider's secrets / environment. Never commit real values.

# REST API: key clients must send as the X-API-Key header
PILOT_API_KEY=change-me-to-a-long-random-string

# Amazon Selling Partner API (Seller Central > Apps and Services > Develop Apps)
AMAZON_LWA_CLIENT_ID=amzn1.application-oa2-client.xxxx
AMAZON_LWA_CLIENT_SECRET=
AMAZON_REFRESH_TOKEN=Atzr|xxxx
AMAZON_SELLER_ID=
AMAZON_MARKETPLACE_ID=A1F83G8C2ARO7P
AMAZON_REGION=eu
AMAZON_SANDBOX=0

# Alibaba.com Open Platform (openapi.alibaba.com > App Console)
ALIBABA_APP_KEY=
ALIBABA_APP_SECRET=
ALIBABA_REDIRECT_URI=https://your-app.example.com/
